# ==========================================================
# Flask Configuration
# ==========================================================

FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-long-random-secret
APP_ENV=development

# ==========================================================
# Database
# ==========================================================

# SQLite (Default)
DATABASE_URL=sqlite:///servicebot.sqlite3

# PostgreSQL Example
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/whatsapp_bot


# ==========================================================
# Default Administrator
# ==========================================================

# These credentials are used ONLY when running:
#
#     flask seed
#
# They are NOT automatically inserted when the application starts.

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@12345
ADMIN_NAME=Project Admin


# ==========================================================
# Business Profile
# ==========================================================

BUSINESS_NAME=Spice Garden Restaurant
BUSINESS_PHONE=+91 98765 43210
BUSINESS_ADDRESS=MG Road, Pune, Maharashtra
BUSINESS_OPENING_HOURS=Mon-Sun 10:00 AM - 11:00 PM
BUSINESS_CURRENCY=INR

PUBLIC_BASE_URL=http://localhost:5000


# ==========================================================
# Twilio WhatsApp
# ==========================================================

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# SECURITY:
# Keep this TRUE in production.
# Change to FALSE only while developing locally if your
# webhook URL cannot be validated.

VALIDATE_TWILIO_SIGNATURE=true


# ==========================================================
# Meta WhatsApp Cloud API
# ==========================================================

META_VERIFY_TOKEN=change-this-verify-token
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v25.0


# ==========================================================
# Demo Data
# ==========================================================

# Demo analytics should NOT load automatically.
# Instead run:
#
#     flask seed
#
# when you intentionally want demo data.

LOAD_DEMO_ANALYTICS=false