# ─────────────────────────────────────────────
# .gitignore — E-Commerce WhatsApp Bot
# ─────────────────────────────────────────────

# ── Secrets (NEVER commit these) ─────────────
.env
*.pem
*.key
*.cert

# ── Python ───────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# ── Virtual environments ──────────────────────
.venv/
venv/
env/
ENV/
.env.local

# ── Flask / SQLite ────────────────────────────
instance/
*.db
*.sqlite
*.sqlite3

# ── Database backups ──────────────────────────
backups/

# ── Migrations (keep if already initialised) ─
# migrations/   ← uncomment to ignore migrations

# ── Testing ───────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ── IDEs / Editors ────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────
*.log
logs/

# ── Docker ────────────────────────────────────
.docker/

# ── OS ────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
