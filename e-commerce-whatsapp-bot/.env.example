# ─────────────────────────────────────────────────────────────
# .env.example — Environment Variable Template
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
#
#   cp .env.example .env
#
# NEVER commit your .env file to Git.
# This .env.example is safe to commit — it contains no secrets.
# ─────────────────────────────────────────────────────────────


# ── Flask Core ────────────────────────────────────────────────
# Generate a strong key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-strong-secret-key-here

# 'development' | 'production' | 'testing'
FLASK_ENV=development


# ── Database ──────────────────────────────────────────────────
# SQLite for local dev (auto-created in instance/ folder)
DATABASE_URL=sqlite:///ecommerce_bot.db

# PostgreSQL for production (uncomment and fill in):
# DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce_bot


# ── WhatsApp Channel ──────────────────────────────────────────
# 'twilio'  → use Twilio sandbox (development, no approval needed)
# 'meta'    → use Meta Cloud API (production)
CHANNEL=twilio


# ── Twilio Sandbox ────────────────────────────────────────────
# Get these from: https://console.twilio.com
# Then join sandbox: WhatsApp → Sandbox → follow the join instructions
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886


# ── Meta WhatsApp Cloud API ───────────────────────────────────
# Get these from: https://developers.facebook.com → Your App → WhatsApp
META_VERIFY_TOKEN=your_webhook_verify_token_here
META_ACCESS_TOKEN=your_permanent_access_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here
META_API_VERSION=v20.0


# ── Bot Identity ──────────────────────────────────────────────
BOT_NAME=ShopBot
STORE_NAME=My E-Commerce Store


# ── Admin Dashboard ───────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password


# ── Lead Scoring Thresholds ───────────────────────────────────
# Score >= HOT_THRESHOLD  → HOT lead
# Score >= WARM_THRESHOLD → WARM lead
# Score <  WARM_THRESHOLD → COLD lead
LEAD_HOT_THRESHOLD=70
LEAD_WARM_THRESHOLD=40


# ── Optional: Ngrok (for local webhook testing with Twilio) ───
# Install ngrok: https://ngrok.com
# Run: ngrok http 5000
# Then set your Twilio sandbox webhook URL to:
#   https://<your-ngrok-id>.ngrok.io/webhook/twilio
# NGROK_URL=https://your-id.ngrok.io
